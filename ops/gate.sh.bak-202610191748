#!/bin/bash
# Source me. pause_batch: SIGSTOP the runner only when its last log line is "finished" (no audit in flight).
B=/home/ubuntu/apps/openseo/batch
RPID=$(cat $B/runner.pid 2>/dev/null)
pause_batch(){ # returns 0 when safe (runner paused between audits or not running)
  kill -0 "$RPID" 2>/dev/null || return 0
  for i in $(seq 1 ${GATE_TRIES:-360}); do
    if tail -1 $B/run.log | grep -q " finished \| timeout \| skip"; then
      kill -STOP "$RPID"; sleep 1
      if tail -1 $B/run.log | grep -q " finished \| timeout \| skip"; then PAUSED=1; return 0; fi
      kill -CONT "$RPID"
    fi
    sleep 5
  done
  return 1
}
resume_batch(){ [ "${PAUSED:-0}" = 1 ] && kill -CONT "$RPID" 2>/dev/null; PAUSED=0; }
